# Copy to Vercel → Project → Settings → Environment Variables
# Never commit real secrets.

# PayPal (live or sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=

# Trade Me API (seller credentials)
TRADEME_CONSUMER_KEY=
TRADEME_CONSUMER_SECRET=
# Optional if you have full OAuth token pair:
# TRADEME_ACCESS_TOKEN=
# TRADEME_ACCESS_TOKEN_SECRET=
# TRADEME_MEMBER_ID=9233545
